<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.smartpantry">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantry">

        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartPantry.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AddEditIngredientActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartPantry.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.RecipeDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartPantry.NoActionBar" />

    </application>
</manifest>
